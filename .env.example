# ====== KAI AI — configuración local ======
# Copiá este archivo como .env (scripts\install.ps1 lo hace por vos) y completá lo necesario.
# Nunca subas tu .env a un repositorio.

# Clave de API de Anthropic (https://console.anthropic.com). Una suscripción Claude Pro/Max NO sirve como clave de API.
# Opcional: también podés cargarla desde la interfaz (Configuración); se guarda en el Administrador de credenciales de Windows.
ANTHROPIC_API_KEY=

# Modo demostración: la interfaz funciona sin IA y cada respuesta se marca como DEMOSTRACIÓN.
KAI_DEMO_MODE=false

# Servidor local. Mantené 127.0.0.1: no expongas KAI Core a la red ni a Internet.
KAI_HOST=127.0.0.1
KAI_PORT=8765
KAI_LOG_LEVEL=INFO

# Carpeta de datos (base SQLite, logs, archivos importados). Por defecto: <repo>\data
# KAI_DATA_DIR=C:\Users\TU_USUARIO\AppData\Local\KAI

# Límites
KAI_CHAT_RATE_LIMIT=20
KAI_MAX_UPLOAD_MB=25
